{
  "meta": {
    "title": "Rocket component properties (simplified)",
    "version": "2.0",
    "levels": [
      "very_low",
      "low",
      "medium",
      "high",
      "very_high"
    ],
    "note": "Every value is one of the five levels. Each option lists only the properties its slot affects."
  },
  "properties": {
    "mass": "Weight the part adds. Lower is better.",
    "drag": "Air resistance during ascent. Lower is better.",
    "heat_resistance": "How much aerodynamic heating the part survives. Higher is better.",
    "strength": "How much aerodynamic and acceleration load the part survives. Higher is better.",
    "stability": "How well the rocket keeps pointing along its path. Higher is better.",
    "fuel": "Propellant carried. Higher gives more delta-v.",
    "thrust": "Engine push. Must be enough to lift the rocket.",
    "efficiency": "Specific impulse: delta-v obtained per kg of propellant. Higher is better.",
    "boiloff": "Propellant lost while waiting on the pad. Lower is better."
  },
